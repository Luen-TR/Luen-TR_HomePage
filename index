<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ルエン_Luen-TR</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', 'Yu Gothic', 'YuGothic', 'Meiryo', sans-serif;
            line-height: 1.6;
            color: #e8e8e8;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            min-height: 100vh;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* ヘッダー */
        header {
            background: rgba(18, 18, 35, 0.85);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
            border-bottom: 1px solid rgba(232, 232, 232, 0.08);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 0;
        }

        .logo {
            font-size: 2.5rem;
            font-weight: bold;
            background: linear-gradient(45deg, #667eea, #764ba2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 2rem;
        }

        .nav-links a {
            text-decoration: none;
            color: #e8e8e8;
            font-weight: 500;
            transition: color 0.3s ease;
            position: relative;
        }

        .nav-links a:hover {
            color: #667eea;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -5px;
            left: 0;
            background: linear-gradient(45deg, #667eea, #764ba2);
            transition: width 0.3s ease;
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        /* メインコンテンツ */
        main {
            padding: 4rem 0;
        }

        .hero {
            text-align: center;
            margin-bottom: 4rem;
            color: #e8e8e8;
        }

        .hero h1 {
            text-align: center;
            font-size: 4rem;
            margin-bottom: 1rem;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
            animation: fadeInUp 1s ease;
            color: #ffffff;
        }

        .hero p {
        text-align: left;
        max-width: 700px;  /* 最大幅を指定 */
        margin: 0 auto 2rem auto;  /* 中央配置 */
        font-size: 1.3rem;
        opacity: 0.9;
        animation: fadeInUp 1s ease 0.3s both;
        color: #e8e8e8;
        }

        .hero .subtitle {
            font-size: 1.1rem;
            opacity: 0.8;
            margin-bottom: 3rem;
            animation: fadeInUp 1s ease 0.6s both;
            color: #cccccc;
        }

        /* 活動カード */
        .activities-section {
            background: rgba(20, 20, 38, 0.8);
            border-radius: 20px;
            padding: 3rem;
            margin-bottom: 3rem;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .section-title {
            text-align: center;
            font-size: 2.5rem;
            margin-bottom: 3rem;
            color: #ffffff;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
        }

        .activities-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
        }

        .activity-card {
            background: linear-gradient(135deg, rgba(40, 40, 60, 0.9) 0%, rgba(30, 30, 50, 0.9) 100%);
            border-radius: 15px;
            padding: 2rem;
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
            text-align: center;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
        }

        .activity-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4);
            border-color: rgba(102, 126, 234, 0.3);
        }

        .activity-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            display: block;
        }

        .activity-card h3 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            color: #ffffff;
        }

        .activity-card p {
                color: #cccccc;
                margin-bottom: 1.5rem;
        }

        .activity-button {
            display: inline-block;
            padding: 0.7rem 1.5rem;
            background: linear-gradient(45deg, #667eea, #764ba2);
            color: #ffffff;
            text-decoration: none;
            border-radius: 25px;
            font-weight: bold;
            transition: all 0.3s ease;
        }

        .activity-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
            background: linear-gradient(45deg, #7a8ef0, #8b5bc2);
        }

        .activity-button.coming-soon {
            background: rgba(74, 74, 74, 0.8);
            color: #999999;
            cursor: not-allowed;
        }

        .activity-button.coming-soon:hover {
            transform: none;
            box-shadow: none;
        }

        /* About セクション */
        .about-section {
            background: rgba(20, 20, 38, 0.8);
            border-radius: 20px;
            padding: 3rem;
            margin-bottom: 3rem;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .about-content {
            max-width: 700px;
            margin: 0 auto;
            text-align: center;
        }

        .about-content p {
            font-size: 1.1rem;
            color: #cccccc;
            margin-bottom: 1.5rem;
        }

        /* 最新情報セクション */
        .news-section {
            background: rgba(20, 20, 38, 0.8);
            border-radius: 20px;
            padding: 3rem;
            margin-bottom: 3rem;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .news-item {
            display: flex;
            align-items: center;
            padding: 1rem 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .news-item:last-child {
            border-bottom: none;
        }

        .news-date {
            background: linear-gradient(45deg, #667eea, #764ba2);
            color: white;
            padding: 0.3rem 0.8rem;
            border-radius: 15px;
            font-size: 0.9rem;
            font-weight: bold;
            margin-right: 1rem;
            min-width: 100px;
            text-align: center;
        }

        .news-content {
            flex: 1;
            color: #cccccc;
        }

        .news-content strong {
            color: #ffffff;
        }

        /* フッター */
        footer {
            background: rgba(10, 10, 20, 0.9);
            color: #e8e8e8;
            text-align: center;
            padding: 2rem 0;
            backdrop-filter: blur(10px);
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .social-links {
            margin-bottom: 1rem;
        }

        .social-links a {
            color: #e8e8e8;
            text-decoration: none;
            margin: 0 1rem;
            transition: color 0.3s ease;
        }

        .social-links a:hover {
            color: #667eea;
        }

        /* アニメーション */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* レスポンシブ */
        @media (max-width: 768px) {
            .nav-links {
                flex-direction: column;
                gap: 1rem;
                display: none;
            }

            .hero h1 {
                font-size: 2.5rem;
            }

            .activities-section,
            .about-section,
            .news-section {
                padding: 2rem;
                margin: 0 10px 2rem;
            }

            .activities-grid {
                grid-template-columns: 1fr;
            }

            .news-item {
                flex-direction: column;
                align-items: flex-start;
            }

            .news-date {
                margin-bottom: 0.5rem;
                margin-right: 0;
            }
        }
    </style>
</head>
<body>
